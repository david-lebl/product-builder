//| mill-jvm-version: system

package build

import mill.*, scalalib.*, scalajslib.*

val scala3Version   = "3.9.0"
val scalaJsVersion  = "1.22.0"
val zioVersion      = "2.1.26"
val zioPreludeVer   = "1.0.0-RC39"
val kyoVersion      = "1.0.0-RC7"
val javaTimeJsVer   = "2.7.0"
val magnumVersion   = "2.0.0"
val jsoniterVersion = "2.38.6"
val flywayVersion   = "11.3.4"
val hikariVersion   = "6.2.1"
val postgresVersion = "42.7.5"
val tcVersion       = "2.0.5"

val commonScalacOptions = Seq(
  "-encoding", "utf-8",
  "-deprecation",
  "-feature",
  "-Xmax-inlines:64",
)

val rootDir = moduleDir

val backendCoreDeps = Seq(
  mvn"dev.zio::zio::${zioVersion}",
  mvn"dev.zio::zio-prelude::${zioPreludeVer}",
)

val backendJsExtraDeps = Seq(
  mvn"io.github.cquiroz::scala-java-time::${javaTimeJsVer}",
)

val backendTestDeps = Seq(
  mvn"dev.zio::zio-test::${zioVersion}",
  mvn"dev.zio::zio-test-sbt::${zioVersion}",
)

// JSON codecs (jsoniter-scala) — cross-compiled, shared by JSONB persistence and HTTP wire format.
val jsonDeps = Seq(
  mvn"com.github.plokhotnyuk.jsoniter-scala::jsoniter-scala-core::${jsoniterVersion}",
  mvn"com.github.plokhotnyuk.jsoniter-scala::jsoniter-scala-macros::${jsoniterVersion}",
)

// JVM-only database infrastructure (Magnum + HikariCP + Flyway + PostgreSQL).
val dbDeps = Seq(
  mvn"com.augustnagro::magnum::${magnumVersion}",
  mvn"com.augustnagro::magnumzio::${magnumVersion}",
  mvn"com.zaxxer:HikariCP:${hikariVersion}",
  mvn"org.flywaydb:flyway-core:${flywayVersion}",
  mvn"org.flywaydb:flyway-database-postgresql:${flywayVersion}",
  mvn"org.postgresql:postgresql:${postgresVersion}",
)

val dbTestDeps = Seq(
  mvn"org.testcontainers:testcontainers-postgresql:${tcVersion}",
  mvn"org.slf4j:slf4j-nop:2.0.17",
)

val kyoUiDeps = Seq(
  mvn"io.getkyo::kyo-ui::${kyoVersion}",
  mvn"io.getkyo::kyo-i18n::${kyoVersion}",
  mvn"io.getkyo::kyo-zio::${kyoVersion}",
)

// ---------------------------------------------------------------------------
// Cross-compiled Backend Modular Monolith (JVM + Scala.js)
// Following guides/scala_3_modulith_boilerplate.md:
//   - `shared` sits at the top (pure primitives, cross-context IDs, EventBus)
//   - Every `<context>/01-c-core` depends ONLY on `shared` (zero cross-core deps)
//   - Zero serialization/DTO libraries in domain cores
// ---------------------------------------------------------------------------

trait BackendJvmModule extends ScalaModule {
  def baseDir: os.Path
  def scalaVersion  = scala3Version
  def scalacOptions = commonScalacOptions
  def sources       = Task.Sources(baseDir / "src" / "main" / "scala")
  def resources     = Task.Sources(baseDir / "src" / "main" / "resources")
  def mvnDeps       = backendCoreDeps

  trait CoreTests extends ScalaTests {
    def sources       = Task.Sources(baseDir / "src" / "test" / "scala")
    def resources     = Task.Sources(baseDir / "src" / "test" / "resources")
    def mvnDeps       = backendTestDeps
    def testFramework = "zio.test.sbt.ZTestFramework"
  }
}

trait BackendJsModule extends ScalaJSModule {
  def baseDir: os.Path
  def scalaVersion   = scala3Version
  def scalaJSVersion = build.scalaJsVersion
  def scalacOptions  = commonScalacOptions
  def sources        = Task.Sources(baseDir / "src" / "main" / "scala")
  def resources      = Task.Sources(baseDir / "src" / "main" / "resources")
  def mvnDeps        = backendCoreDeps ++ backendJsExtraDeps
}

/** JVM-only outbound persistence adapter (`<context>/02-o-db`) built on `backend/platform` (Magnum). */
trait BackendDbModule extends BackendJvmModule {
  def mvnDeps = backendCoreDeps ++ dbDeps ++ jsonDeps

  trait DbTests extends CoreTests {
    def mvnDeps = backendTestDeps ++ dbTestDeps
  }
}

object backend extends Module {
  private val backendDir = rootDir / "backend"

  /** Top kernel: pure primitives, cross-context IDs, measurements, Money, EventBus. */
  object shared extends Module {
    private val dir = backendDir / "shared"
    object jvm extends BackendJvmModule {
      def baseDir = dir
      object test extends CoreTests
    }
    object js extends BackendJsModule {
      def baseDir = dir
    }
  }

  /** Bounded Context 1: Product Catalog, Capabilities, Rules, Imposition & Configuration. */
  object catalog extends Module {
    object `01-c-core` extends Module {
      private val dir = backendDir / "catalog" / "01-c-core"
      object jvm extends BackendJvmModule {
        def baseDir    = dir
        def moduleDeps = Seq(backend.shared.jvm)
        object test extends CoreTests
      }
      object js extends BackendJsModule {
        def baseDir    = dir
        def moduleDeps = Seq(backend.shared.js)
      }
    }

    /** Outbound PostgreSQL persistence adapter (Magnum) for `catalog` repositories. */
    object `02-o-db` extends BackendDbModule {
      def baseDir    = backendDir / "catalog" / "02-o-db"
      def moduleDeps = Seq(backend.catalog.`01-c-core`.jvm, backend.platform, backend.json.jvm)
      object test extends DbTests {
        def moduleDeps = super.moduleDeps ++ Seq(backend.sample.jvm, backend.platform.test)
      }
    }
  }

  /** Bounded Context 2: Commercial Pricing, Customer Agreements, Promo Codes & Margin Analysis. */
  object pricing extends Module {
    object `01-c-core` extends Module {
      private val dir = backendDir / "pricing" / "01-c-core"
      object jvm extends BackendJvmModule {
        def baseDir    = dir
        def moduleDeps = Seq(backend.shared.jvm)
        object test extends CoreTests
      }
      object js extends BackendJsModule {
        def baseDir    = dir
        def moduleDeps = Seq(backend.shared.js)
      }
    }

    /** Outbound PostgreSQL persistence adapter (Magnum) for `pricing` repositories. */
    object `02-o-db` extends BackendDbModule {
      def baseDir    = backendDir / "pricing" / "02-o-db"
      def moduleDeps = Seq(backend.pricing.`01-c-core`.jvm, backend.platform, backend.json.jvm)
      object test extends DbTests {
        def moduleDeps = super.moduleDeps ++ Seq(backend.sample.jvm, backend.platform.test)
      }
    }
  }

  /** Bounded Context 3: Customer Accounts, Organizations, Tiers & Credit Terms. */
  object customers extends Module {
    object `01-c-core` extends Module {
      private val dir = backendDir / "customers" / "01-c-core"
      object jvm extends BackendJvmModule {
        def baseDir    = dir
        def moduleDeps = Seq(backend.shared.jvm)
        object test extends CoreTests
      }
      object js extends BackendJsModule {
        def baseDir    = dir
        def moduleDeps = Seq(backend.shared.js)
      }
    }

    /** Outbound PostgreSQL persistence adapter (Magnum) for `customers` repositories. */
    object `02-o-db` extends BackendDbModule {
      def baseDir    = backendDir / "customers" / "02-o-db"
      def moduleDeps = Seq(backend.customers.`01-c-core`.jvm, backend.platform, backend.json.jvm)
      object test extends DbTests {
        def moduleDeps = super.moduleDeps ++ Seq(backend.sample.jvm, backend.platform.test)
      }
    }
  }

  /** Bounded Context 4: Artwork Assets, Revisions & Prepress Preflight. */
  object artwork extends Module {
    object `01-c-core` extends Module {
      private val dir = backendDir / "artwork" / "01-c-core"
      object jvm extends BackendJvmModule {
        def baseDir    = dir
        def moduleDeps = Seq(backend.shared.jvm)
        object test extends CoreTests
      }
      object js extends BackendJsModule {
        def baseDir    = dir
        def moduleDeps = Seq(backend.shared.js)
      }
    }

    /** Outbound PostgreSQL persistence adapter (Magnum) for `artwork` repositories. */
    object `02-o-db` extends BackendDbModule {
      def baseDir    = backendDir / "artwork" / "02-o-db"
      def moduleDeps = Seq(backend.artwork.`01-c-core`.jvm, backend.platform, backend.json.jvm)
      object test extends DbTests {
        def moduleDeps = super.moduleDeps ++ Seq(backend.sample.jvm, backend.platform.test)
      }
    }
  }

  /** Bounded Context 5: Shopping Cart, Order Placement & Order Lifecycle. */
  object ordering extends Module {
    object `01-c-core` extends Module {
      private val dir = backendDir / "ordering" / "01-c-core"
      object jvm extends BackendJvmModule {
        def baseDir    = dir
        def moduleDeps = Seq(backend.shared.jvm)
        object test extends CoreTests
      }
      object js extends BackendJsModule {
        def baseDir    = dir
        def moduleDeps = Seq(backend.shared.js)
      }
    }

    /** Outbound PostgreSQL persistence adapter (Magnum) for `ordering` repositories. */
    object `02-o-db` extends BackendDbModule {
      def baseDir    = backendDir / "ordering" / "02-o-db"
      def moduleDeps = Seq(backend.ordering.`01-c-core`.jvm, backend.platform, backend.json.jvm)
      object test extends DbTests {
        def moduleDeps = super.moduleDeps ++ Seq(backend.sample.jvm, backend.platform.test)
      }
    }
  }

  /** Bounded Context 6: Shop-Floor Manufacturing Workflows, Capacity & Fulfilment. */
  object manufacturing extends Module {
    object `01-c-core` extends Module {
      private val dir = backendDir / "manufacturing" / "01-c-core"
      object jvm extends BackendJvmModule {
        def baseDir    = dir
        def moduleDeps = Seq(backend.shared.jvm)
        object test extends CoreTests
      }
      object js extends BackendJsModule {
        def baseDir    = dir
        def moduleDeps = Seq(backend.shared.js)
      }
    }
  }

  /** Bounded Context 7: Identity, Authentication (Password + OTP) & Sessions. */
  object identity extends Module {
    object `01-c-core` extends Module {
      private val dir = backendDir / "identity" / "01-c-core"
      object jvm extends BackendJvmModule {
        def baseDir    = dir
        def moduleDeps = Seq(backend.shared.jvm)
        object test extends CoreTests
      }
      object js extends BackendJsModule {
        def baseDir    = dir
        def moduleDeps = Seq(backend.shared.js)
      }
    }

    /** Outbound PostgreSQL persistence adapter (Magnum) for `identity` repositories. */
    object `02-o-db` extends BackendDbModule {
      def baseDir    = backendDir / "identity" / "02-o-db"
      def moduleDeps = Seq(backend.identity.`01-c-core`.jvm, backend.platform, backend.json.jvm)
      object test extends DbTests {
        def moduleDeps = super.moduleDeps ++ Seq(backend.sample.jvm, backend.platform.test)
      }
    }
  }

  /** Storefront BFF / Application Orchestration Facade (depends ONLY on public context APIs). */
  object storefront extends Module {
    private val dir = backendDir / "storefront"
    object jvm extends BackendJvmModule {
      def baseDir = dir
      def moduleDeps = Seq(
        backend.shared.jvm,
        backend.catalog.`01-c-core`.jvm,
        backend.pricing.`01-c-core`.jvm,
        backend.customers.`01-c-core`.jvm,
        backend.identity.`01-c-core`.jvm,
        backend.artwork.`01-c-core`.jvm,
        backend.ordering.`01-c-core`.jvm,
        backend.manufacturing.`01-c-core`.jvm,
      )
      object test extends CoreTests
    }
    object js extends BackendJsModule {
      def baseDir = dir
      def moduleDeps = Seq(
        backend.shared.js,
        backend.catalog.`01-c-core`.js,
        backend.pricing.`01-c-core`.js,
        backend.customers.`01-c-core`.js,
        backend.identity.`01-c-core`.js,
        backend.artwork.`01-c-core`.js,
        backend.ordering.`01-c-core`.js,
        backend.manufacturing.`01-c-core`.js,
      )
    }
  }

  /** Backoffice / Admin BFF & Order Intake Orchestration Facade (depends ONLY on public context APIs). */
  object backoffice extends Module {
    private val dir = backendDir / "backoffice"
    object jvm extends BackendJvmModule {
      def baseDir = dir
      def moduleDeps = Seq(
        backend.shared.jvm,
        backend.catalog.`01-c-core`.jvm,
        backend.pricing.`01-c-core`.jvm,
        backend.customers.`01-c-core`.jvm,
        backend.identity.`01-c-core`.jvm,
        backend.ordering.`01-c-core`.jvm,
        backend.artwork.`01-c-core`.jvm,
      )
      object test extends CoreTests
    }
    object js extends BackendJsModule {
      def baseDir = dir
      def moduleDeps = Seq(
        backend.shared.js,
        backend.catalog.`01-c-core`.js,
        backend.pricing.`01-c-core`.js,
        backend.customers.`01-c-core`.js,
        backend.identity.`01-c-core`.js,
        backend.ordering.`01-c-core`.js,
        backend.artwork.`01-c-core`.js,
      )
    }
  }

  /** Sample data, in-memory adapters, cross-context ACL bridges & standalone showcase runtime. */
  object sample extends Module {
    private val dir = backendDir / "sample"
    object jvm extends BackendJvmModule {
      def baseDir = dir
      def moduleDeps = Seq(
        backend.shared.jvm,
        backend.catalog.`01-c-core`.jvm,
        backend.pricing.`01-c-core`.jvm,
        backend.customers.`01-c-core`.jvm,
        backend.identity.`01-c-core`.jvm,
        backend.artwork.`01-c-core`.jvm,
        backend.ordering.`01-c-core`.jvm,
        backend.manufacturing.`01-c-core`.jvm,
        backend.storefront.jvm,
        backend.backoffice.jvm,
      )
      object test extends CoreTests
    }
    object js extends BackendJsModule {
      def baseDir = dir
      def moduleDeps = Seq(
        backend.shared.js,
        backend.catalog.`01-c-core`.js,
        backend.pricing.`01-c-core`.js,
        backend.customers.`01-c-core`.js,
        backend.identity.`01-c-core`.js,
        backend.artwork.`01-c-core`.js,
        backend.ordering.`01-c-core`.js,
        backend.manufacturing.`01-c-core`.js,
        backend.storefront.js,
        backend.backoffice.js,
      )
    }
  }

  /** Cross-compiled jsoniter-scala codecs for every public domain model (JSONB persistence + HTTP wire). */
  object json extends Module {
    private val dir = backendDir / "json"
    private def coreJvm = Seq(
      backend.shared.jvm,
      backend.catalog.`01-c-core`.jvm,
      backend.pricing.`01-c-core`.jvm,
      backend.customers.`01-c-core`.jvm,
      backend.identity.`01-c-core`.jvm,
      backend.artwork.`01-c-core`.jvm,
      backend.ordering.`01-c-core`.jvm,
      backend.manufacturing.`01-c-core`.jvm,
    )
    object jvm extends BackendJvmModule {
      def baseDir    = dir
      def moduleDeps = coreJvm
      def mvnDeps    = backendCoreDeps ++ jsonDeps
      object test extends CoreTests {
        def moduleDeps = super.moduleDeps ++ Seq(backend.sample.jvm)
      }
    }
    object js extends BackendJsModule {
      def baseDir = dir
      def moduleDeps = Seq(
        backend.shared.js,
        backend.catalog.`01-c-core`.js,
        backend.pricing.`01-c-core`.js,
        backend.customers.`01-c-core`.js,
        backend.identity.`01-c-core`.js,
        backend.artwork.`01-c-core`.js,
        backend.ordering.`01-c-core`.js,
        backend.manufacturing.`01-c-core`.js,
      )
      def mvnDeps = backendCoreDeps ++ backendJsExtraDeps ++ jsonDeps
    }
  }

  /** Bottom infrastructure (JVM): Magnum/HikariCP database pool, Flyway migrations, local blob storage. */
  object platform extends BackendJvmModule {
    def baseDir    = backendDir / "platform"
    def moduleDeps = Seq(backend.shared.jvm)
    def mvnDeps    = backendCoreDeps ++ dbDeps
    object test extends CoreTests {
      def mvnDeps = backendTestDeps ++ dbTestDeps
    }
  }

  /** Composition root (JVM): per-context PostgreSQL wiring & DB seeder (HTTP server arrives in Phase 4). */
  object app extends BackendJvmModule {
    def baseDir = backendDir / "app"
    def moduleDeps = Seq(
      backend.platform,
      backend.sample.jvm,
      backend.catalog.`02-o-db`,
      backend.pricing.`02-o-db`,
      backend.customers.`02-o-db`,
      backend.identity.`02-o-db`,
      backend.ordering.`02-o-db`,
      backend.artwork.`02-o-db`,
    )
    def mvnDeps = backendCoreDeps ++ dbDeps
    object test extends CoreTests {
      def mvnDeps    = backendTestDeps :+ mvn"org.testcontainers:testcontainers-postgresql:${tcVersion}"
      def moduleDeps = super.moduleDeps ++ Seq(backend.platform.test)
    }
  }

}

// ---------------------------------------------------------------------------
// UI Core — Cross-compiled Kyo UI views, theme, i18n, configurator & storefront.
// Compiles to BOTH JVM (SSR / Kyo server-push / tests) and Scala.js (browser SPA).
// Depends ONLY on public backend models & StorefrontClient port (never backend.sample).
// ---------------------------------------------------------------------------

object `ui-core` extends Module {
  private val dir = rootDir / "modules" / "ui-core"

  object jvm extends ScalaModule {
    def scalaVersion  = scala3Version
    def scalacOptions = commonScalacOptions
    def sources       = Task.Sources(dir / "src" / "main" / "scala")
    def resources     = Task.Sources(dir / "src" / "main" / "resources")
    def moduleDeps = Seq(
      backend.shared.jvm,
      backend.catalog.`01-c-core`.jvm,
      backend.pricing.`01-c-core`.jvm,
      backend.customers.`01-c-core`.jvm,
      backend.identity.`01-c-core`.jvm,
      backend.artwork.`01-c-core`.jvm,
      backend.ordering.`01-c-core`.jvm,
      backend.storefront.jvm,
    )
    def mvnDeps = kyoUiDeps

    object test extends ScalaTests {
      def sources       = Task.Sources(dir / "src" / "test" / "scala")
      def resources     = Task.Sources(dir / "src" / "test" / "resources")
      def moduleDeps    = Seq(`ui-core`.jvm, backend.sample.jvm)
      def mvnDeps       = backendTestDeps
      def testFramework = "zio.test.sbt.ZTestFramework"
    }
  }

  object js extends ScalaJSModule {
    def scalaVersion   = scala3Version
    def scalaJSVersion = build.scalaJsVersion
    def scalacOptions  = commonScalacOptions
    def sources        = Task.Sources(dir / "src" / "main" / "scala")
    def resources      = Task.Sources(dir / "src" / "main" / "resources")
    def moduleDeps = Seq(
      backend.shared.js,
      backend.catalog.`01-c-core`.js,
      backend.pricing.`01-c-core`.js,
      backend.customers.`01-c-core`.js,
      backend.identity.`01-c-core`.js,
      backend.artwork.`01-c-core`.js,
      backend.ordering.`01-c-core`.js,
      backend.storefront.js,
    )
    def mvnDeps = kyoUiDeps
  }
}

// ---------------------------------------------------------------------------
// UI Admin Core — Cross-compiled Kyo UI Backoffice & Order Intake modules.
// Compiles to BOTH JVM (SSR / Kyo server-push / tests) and Scala.js (browser SPA).
// Depends ONLY on ui-core, public backend APIs & BackofficeClient port (never backend.sample).
// ---------------------------------------------------------------------------

object `ui-admin-core` extends Module {
  private val dir = rootDir / "modules" / "ui-admin-core"

  object jvm extends ScalaModule {
    def scalaVersion  = scala3Version
    def scalacOptions = commonScalacOptions
    def sources       = Task.Sources(dir / "src" / "main" / "scala")
    def resources     = Task.Sources(dir / "src" / "main" / "resources")
    def moduleDeps = Seq(
      `ui-core`.jvm,
      backend.artwork.`01-c-core`.jvm,
      backend.backoffice.jvm,
    )
    def mvnDeps = kyoUiDeps

    object test extends ScalaTests {
      def sources       = Task.Sources(dir / "src" / "test" / "scala")
      def resources     = Task.Sources(dir / "src" / "test" / "resources")
      def moduleDeps    = Seq(`ui-admin-core`.jvm, backend.sample.jvm)
      def mvnDeps       = backendTestDeps
      def testFramework = "zio.test.sbt.ZTestFramework"
    }
  }

  object js extends ScalaJSModule {
    def scalaVersion   = scala3Version
    def scalaJSVersion = build.scalaJsVersion
    def scalacOptions  = commonScalacOptions
    def sources        = Task.Sources(dir / "src" / "main" / "scala")
    def resources      = Task.Sources(dir / "src" / "main" / "resources")
    def moduleDeps = Seq(
      `ui-core`.js,
      backend.artwork.`01-c-core`.js,
      backend.backoffice.js,
    )
    def mvnDeps = kyoUiDeps
  }
}

// ---------------------------------------------------------------------------
// UI — Static Scala.js Unified Demo SPA (Storefront + #/admin Backoffice)
// Shares a single in-memory SampleShowcaseRuntime so Storefront orders land
// immediately in Staff Order Intake.
// ---------------------------------------------------------------------------

object ui extends ScalaJSModule {
  def scalaVersion                    = scala3Version
  def scalaJSVersion                  = build.scalaJsVersion
  def scalacOptions                   = commonScalacOptions
  def sources                         = Task.Sources(rootDir / "modules" / "ui" / "src" / "main" / "scala")
  def resources                       = Task.Sources(rootDir / "modules" / "ui" / "src" / "main" / "resources")
  def scalaJSUseMainModuleInitializer = true
  def moduleDeps                      = Seq(`ui-core`.js, `ui-admin-core`.js, backend.sample.js)
  def mvnDeps                         = kyoUiDeps
}

// ---------------------------------------------------------------------------
// UI Admin — Standalone Scala.js Backoffice SPA powered by Kyo UI + backend.sample
// Deployable independently on its own host/path (e.g. /admin).
// ---------------------------------------------------------------------------

object `ui-admin` extends ScalaJSModule {
  def scalaVersion                    = scala3Version
  def scalaJSVersion                  = build.scalaJsVersion
  def scalacOptions                   = commonScalacOptions
  def sources                         = Task.Sources(rootDir / "modules" / "ui-admin" / "src" / "main" / "scala")
  def resources                       = Task.Sources(rootDir / "modules" / "ui-admin" / "src" / "main" / "resources")
  def scalaJSUseMainModuleInitializer = true
  def moduleDeps                      = Seq(`ui-admin-core`.js, backend.sample.js)
  def mvnDeps                         = kyoUiDeps
}

// ---------------------------------------------------------------------------
// UI Calculator — Standalone Embeddable Price Calculator (Kyo UI, Scala.js lib)
// Exports global `MPCalculator` with `mount(selector, config)`.
// ---------------------------------------------------------------------------

object `ui-calculator` extends ScalaJSModule {
  def scalaVersion                  = scala3Version
  def scalaJSVersion                = build.scalaJsVersion
  def scalacOptions                 = commonScalacOptions
  def sources                       = Task.Sources(rootDir / "modules" / "ui-calculator" / "src" / "main" / "scala")
  def resources                     = Task.Sources(rootDir / "modules" / "ui-calculator" / "src" / "main" / "resources")
  def scalaJSUseMainModuleInitializer = false
  def moduleDeps                    = Seq(`ui-core`.js, backend.sample.js)
