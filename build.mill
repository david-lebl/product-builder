    def resources      = Task.Sources(dir / "src" / "main" / "resources")
    def moduleDeps = Seq(
      `ui-core`.js,
      backend.artwork.`01-c-core`.js,
      backend.backoffice.js,
      backend.json.js,
    )
    def mvnDeps = kyoUiDeps ++ jsonDeps
  }
}

// ---------------------------------------------------------------------------
// UI Editor Core — Cross-compiled Kyo UI Visual Editor (design studio) library.
// Shared sources are pure (JVM-testable); `src/main/scala-js` holds the browser glue (pointer gestures,
// IndexedDB design/photo storage, file picking, fonts). Linked only into the `ui-editor` page bundle.
// ---------------------------------------------------------------------------

object `ui-editor-core` extends Module {
  private val dir = rootDir / "modules" / "ui-editor-core"

  object jvm extends ScalaModule {
    def scalaVersion  = scala3Version
    def scalacOptions = commonScalacOptions
    def sources       = Task.Sources(dir / "src" / "main" / "scala")
    def resources     = Task.Sources(dir / "src" / "main" / "resources")
    def moduleDeps    = Seq(`ui-core`.jvm, backend.design.`01-c-core`.jvm, backend.json.jvm)
    def mvnDeps       = kyoUiDeps ++ jsonDeps

    object test extends ScalaTests {
      def sources       = Task.Sources(dir / "src" / "test" / "scala")
      def resources     = Task.Sources(dir / "src" / "test" / "resources")
      def moduleDeps    = Seq(`ui-editor-core`.jvm)
      def mvnDeps       = backendTestDeps
      def testFramework = kyoTestFramework
    }
  }

  object js extends ScalaJSModule {
    def scalaVersion   = scala3Version
    def scalaJSVersion = build.scalaJsVersion
    def scalacOptions  = commonScalacOptions
    def sources        = Task.Sources(dir / "src" / "main" / "scala", dir / "src" / "main" / "scala-js")
    def resources      = Task.Sources(dir / "src" / "main" / "resources")
    def moduleDeps     = Seq(`ui-core`.js, backend.design.`01-c-core`.js, backend.json.js)
    def mvnDeps        = kyoUiDeps ++ jsonDeps
  }
}

// ---------------------------------------------------------------------------
// UI — Static Scala.js Unified Demo SPA (Storefront + #/admin Backoffice)
// Shares a single in-memory SampleShowcaseRuntime so Storefront orders land
// immediately in Staff Order Intake.
// ---------------------------------------------------------------------------

object ui extends ScalaJSModule {
  def scalaVersion                    = scala3Version
  def scalaJSVersion                  = build.scalaJsVersion
  def scalacOptions                   = commonScalacOptions
  def sources                         = Task.Sources(rootDir / "modules" / "ui" / "src" / "main" / "scala")
  def resources                       = Task.Sources(rootDir / "modules" / "ui" / "src" / "main" / "resources")
  def scalaJSUseMainModuleInitializer = true
  def moduleDeps                      = Seq(`ui-core`.js, `ui-admin-core`.js, `ui-http-client`.js, backend.sample.js)
  def mvnDeps                         = kyoUiDeps
}

// ---------------------------------------------------------------------------
// UI Admin — Standalone Scala.js Backoffice SPA powered by Kyo UI + backend.sample
// Deployable independently on its own host/path (e.g. /admin).
// ---------------------------------------------------------------------------

object `ui-admin` extends ScalaJSModule {
  def scalaVersion                    = scala3Version
  def scalaJSVersion                  = build.scalaJsVersion
  def scalacOptions                   = commonScalacOptions
  def sources                         = Task.Sources(rootDir / "modules" / "ui-admin" / "src" / "main" / "scala")
  def resources                       = Task.Sources(rootDir / "modules" / "ui-admin" / "src" / "main" / "resources")
  def scalaJSUseMainModuleInitializer = true
  def moduleDeps                      = Seq(`ui-admin-core`.js, `ui-http-client`.js, backend.sample.js)
  def mvnDeps                         = kyoUiDeps
}

// ---------------------------------------------------------------------------
// UI Editor — Design Studio page (Kyo UI, Scala.js app) deployed to `_site/editor/`.
// Used standalone AND embedded by the storefront in a full-screen <iframe> (postMessage contract, see
// `mpbuilder.editor.EmbedProtocol`), so the storefront / calculator / backoffice bundles never contain it.
// ---------------------------------------------------------------------------

object `ui-editor` extends ScalaJSModule {
  def scalaVersion                    = scala3Version
  def scalaJSVersion                  = build.scalaJsVersion
  def scalacOptions                   = commonScalacOptions
  def sources                         = Task.Sources(rootDir / "modules" / "ui-editor" / "src" / "main" / "scala")
  def resources                       = Task.Sources(rootDir / "modules" / "ui-editor" / "src" / "main" / "resources")
  def scalaJSUseMainModuleInitializer = true
  def moduleDeps                      = Seq(`ui-editor-core`.js)
  def mvnDeps                         = kyoUiDeps
}

// ---------------------------------------------------------------------------
// UI Calculator — Standalone Embeddable Price Calculator (Kyo UI, Scala.js lib)
// Exports global `MPCalculator` with `mount(selector, config)`.
// ---------------------------------------------------------------------------

object `ui-calculator` extends ScalaJSModule {
  def scalaVersion                  = scala3Version
  def scalaJSVersion                = build.scalaJsVersion
  def scalacOptions                 = commonScalacOptions
  def sources                       = Task.Sources(rootDir / "modules" / "ui-calculator" / "src" / "main" / "scala")
  def resources                     = Task.Sources(rootDir / "modules" / "ui-calculator" / "src" / "main" / "resources")
  def scalaJSUseMainModuleInitializer = false
  def moduleDeps                    = Seq(`ui-core`.js, `ui-http-client`.js, backend.sample.js)
  def mvnDeps                       = kyoUiDeps
}

// ---------------------------------------------------------------------------
// UI HTTP Client — Cross-compiled HTTP adapters implementing `StorefrontFacade` /
// `BackofficeFacade` over the `/api/v1` JSON API (kyo-schema wire format), exposed to
// the UI through `StorefrontClient.fromFacade` / `BackofficeClient.fromFacade`.
// ---------------------------------------------------------------------------

object `ui-http-client` extends Module {
  private val dir = rootDir / "modules" / "ui-http-client"

  /** JVM transport: kyo-http client (used by the E2E tests against the live server). */
  object jvm extends ScalaModule {
    def scalaVersion  = scala3Version
    def scalacOptions = commonScalacOptions
    def sources       = Task.Sources(dir / "src" / "main" / "scala", dir / "src" / "main" / "scala-jvm")
    def moduleDeps    = Seq(backend.storefront.`01-i-http-api`.jvm, backend.backoffice.`01-i-http-api`.jvm, `ui-core`.jvm, `ui-admin-core`.jvm)
    def mvnDeps       = kyoUiDeps ++ httpDeps
  }

  /** Browser transport: `window.fetch`. */
  object js extends ScalaJSModule {
    def scalaVersion   = scala3Version
    def scalaJSVersion = build.scalaJsVersion
    def scalacOptions  = commonScalacOptions
    def sources        = Task.Sources(dir / "src" / "main" / "scala", dir / "src" / "main" / "scala-js")
    def moduleDeps     = Seq(backend.storefront.`01-i-http-api`.js, backend.backoffice.`01-i-http-api`.js, `ui-core`.js, `ui-admin-core`.js)
    def mvnDeps        = kyoUiDeps
  }
}
