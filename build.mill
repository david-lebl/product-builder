  /** Bounded Context 8: Customer Design Projects — Visual Editor document model, templates, preflight,
    * SVG renderer and the design persistence/sync service. Cross-compiled so the browser editor, the
    * storefront and the future server-side PDF renderer share one model. */
  object design extends Module {
    object `01-c-core` extends Module {
      private val dir = backendDir / "design" / "01-c-core"
      object jvm extends BackendJvmModule {
        def baseDir    = dir
        def moduleDeps = Seq(backend.shared.jvm)
        object test extends CoreTests
      }
      object js extends BackendJsModule {
        def baseDir    = dir
        def moduleDeps = Seq(backend.shared.js)
      }
    }
  }

  /** Storefront BFF / Application Orchestration Facade (depends ONLY on public context APIs). */
  object storefront extends Module {
    private val dir = backendDir / "storefront"
    object jvm extends BackendJvmModule {
      def baseDir = dir
      def moduleDeps = Seq(
        backend.shared.jvm,
        backend.catalog.`01-c-core`.jvm,
        backend.pricing.`01-c-core`.jvm,
        backend.customers.`01-c-core`.jvm,
        backend.identity.`01-c-core`.jvm,
        backend.artwork.`01-c-core`.jvm,
        backend.ordering.`01-c-core`.jvm,
        backend.manufacturing.`01-c-core`.jvm,
      )
      object test extends CoreTests
    }
    object js extends BackendJsModule {
      def baseDir = dir
      def moduleDeps = Seq(
        backend.shared.js,
        backend.catalog.`01-c-core`.js,
        backend.pricing.`01-c-core`.js,
        backend.customers.`01-c-core`.js,
        backend.identity.`01-c-core`.js,
        backend.artwork.`01-c-core`.js,
        backend.ordering.`01-c-core`.js,
        backend.manufacturing.`01-c-core`.js,
      )
    }

    /** `01-i-http-api`: wire DTOs, schemas & URL paths of the storefront HTTP API (JVM + JS). */
    object `01-i-http-api` extends Module {
      private val apiDir = dir / "01-i-http-api"
      object jvm extends BackendJvmModule {
        def baseDir    = apiDir
        def moduleDeps = Seq(backend.`api-kernel`.jvm, backend.storefront.jvm)
        def mvnDeps    = backendCoreDeps ++ jsonDeps
      }
      object js extends BackendJsModule {
        def baseDir    = apiDir
        def moduleDeps = Seq(backend.`api-kernel`.js, backend.storefront.js)
        def mvnDeps    = backendCoreDeps ++ backendJsExtraDeps ++ jsonDeps
      }
    }

    /** `02-i-http`: inbound kyo-http routes binding the API to the facade (JVM). */
    object `02-i-http` extends BackendJvmModule {
      def baseDir    = dir / "02-i-http"
      def moduleDeps = Seq(backend.storefront.`01-i-http-api`.jvm)
      def mvnDeps    = backendCoreDeps ++ jsonDeps ++ httpDeps
    }
  }

  /** Backoffice / Admin BFF & Order Intake Orchestration Facade (depends ONLY on public context APIs). */
  object backoffice extends Module {
    private val dir = backendDir / "backoffice"
    object jvm extends BackendJvmModule {
      def baseDir = dir
      def moduleDeps = Seq(
        backend.shared.jvm,
        backend.catalog.`01-c-core`.jvm,
        backend.pricing.`01-c-core`.jvm,
        backend.customers.`01-c-core`.jvm,
