//| mill-jvm-version: system

package build

import mill.*, scalalib.*, scalajslib.*

val scala3Version = "3.3.3"
val scalaJsVersion = "1.18.1"
val laminarVersion = "17.2.0"

val commonScalacOptions = Seq(
  "-encoding", "utf-8",
  "-deprecation",
  "-feature",
  "-Xmax-inlines:64"
)

val rootDir = moduleDir
val commonsDir = rootDir / "modules" / "commons"
val domainDir = rootDir / "modules" / "domain"

val domainMvnDeps = Seq(
  mvn"dev.zio::zio::2.1.16",
  mvn"dev.zio::zio-prelude::1.0.0-RC39",
  mvn"dev.zio::zio-json::0.7.3",
  mvn"com.softwaremill.quicklens::quicklens::1.9.12"
)

// ---------------------------------------------------------------------------
// Commons — shared kernel. Cross-compiled for JVM and JS. Depends on nothing:
// Money/Language/Quantity and friends are owned by no bounded context, so
// putting them here is what keeps `model` and `pricing` from importing each
// other. Business concepts (CategoryId, CustomerType, …) do NOT belong here.
// ---------------------------------------------------------------------------

object commons extends Module {

  /** Commons JVM target */
  object jvm extends ScalaModule {
    def scalaVersion = scala3Version
    def scalacOptions = commonScalacOptions
    def sources = Task.Sources(commonsDir / "src" / "main" / "scala")
    def mvnDeps = domainMvnDeps

    object test extends ScalaTests {
      def sources = Task.Sources(commonsDir / "src" / "test" / "scala")
      def mvnDeps = Seq(
        mvn"dev.zio::zio-test::2.1.16",
        mvn"dev.zio::zio-test-sbt::2.1.16"
      )
      def testFramework = "zio.test.sbt.ZTestFramework"
    }
  }

  /** Commons Scala.js target */
  object js extends ScalaJSModule {
    def scalaVersion = scala3Version
    def scalaJSVersion = build.scalaJsVersion
    def scalacOptions = commonScalacOptions
    def sources = Task.Sources(commonsDir / "src" / "main" / "scala")
    def mvnDeps = domainMvnDeps
  }
}

// ---------------------------------------------------------------------------
// Domain — cross-compiled for JVM and JS (shared pure sources)
// ---------------------------------------------------------------------------

object domain extends Module {

  /** Domain JVM target */
  object jvm extends ScalaModule {
    def scalaVersion = scala3Version
    def scalacOptions = commonScalacOptions
    def sources = Task.Sources(domainDir / "src" / "main" / "scala")
    def resources = Task.Sources(domainDir / "src" / "main" / "resources")
    def moduleDeps = Seq(commons.jvm)
    def mvnDeps = domainMvnDeps

    object test extends ScalaTests {
      def sources = Task.Sources(domainDir / "src" / "test" / "scala")
      def resources = Task.Sources(domainDir / "src" / "test" / "resources")
      def mvnDeps = Seq(
        mvn"dev.zio::zio-test::2.1.16",
        mvn"dev.zio::zio-test-sbt::2.1.16"
      )
      def testFramework = "zio.test.sbt.ZTestFramework"
    }
  }

  /** Domain Scala.js target */
  object js extends ScalaJSModule {
    def scalaVersion = scala3Version
    def scalaJSVersion = build.scalaJsVersion
    def scalacOptions = commonScalacOptions
    def sources = Task.Sources(domainDir / "src" / "main" / "scala")
    def resources = Task.Sources(domainDir / "src" / "main" / "resources")
    def moduleDeps = Seq(commons.js)
    def mvnDeps = domainMvnDeps
  }
}

// ---------------------------------------------------------------------------
// Catalog — bounded context: what can be built.
//
//   01-core   public contract (service traits, DTOs, errors). Depends on
//             `commons` ONLY — never on another context's core, and never on
//             any infra. Cross-compiled: the offline calculator will run it.
//   02-infra  adapters. Today the only implementation delegates to the legacy
//             `domain` module; in Phase 7 the model moves into 01-core/impl and
//             this shrinks to persistence + HTTP. JVM only.
// ---------------------------------------------------------------------------

object catalog extends Module {
  private val base = rootDir / "modules" / "catalog"

  object `01-core` extends Module {
    object jvm extends ScalaModule {
      def scalaVersion = scala3Version
      def scalacOptions = commonScalacOptions
      def sources = Task.Sources(base / "01-core" / "src" / "main" / "scala")
      def moduleDeps = Seq(commons.jvm)
      def mvnDeps = domainMvnDeps
    }

    object js extends ScalaJSModule {
      def scalaVersion = scala3Version
      def scalaJSVersion = build.scalaJsVersion
      def scalacOptions = commonScalacOptions
      def sources = Task.Sources(base / "01-core" / "src" / "main" / "scala")
      def moduleDeps = Seq(commons.js)
      def mvnDeps = domainMvnDeps
    }
  }

  object `02-infra` extends ScalaModule {
    def scalaVersion = scala3Version
    def scalacOptions = commonScalacOptions
    def sources = Task.Sources(base / "02-infra" / "src" / "main" / "scala")
    def moduleDeps = Seq(`01-core`.jvm, domain.jvm)
    def mvnDeps = domainMvnDeps

    object test extends ScalaTests {
      def sources = Task.Sources(base / "02-infra" / "src" / "test" / "scala")
      def mvnDeps = Seq(
        mvn"dev.zio::zio-test::2.1.16",
        mvn"dev.zio::zio-test-sbt::2.1.16"
      )
      def testFramework = "zio.test.sbt.ZTestFramework"
    }
  }
}

// ---------------------------------------------------------------------------
// Pricing — bounded context: what it costs. Owns discount codes, so there can
// only ever be one place a discount is computed.
// ---------------------------------------------------------------------------

object pricing extends Module {
  private val base = rootDir / "modules" / "pricing"

  object `01-core` extends Module {
    object jvm extends ScalaModule {
      def scalaVersion = scala3Version
      def scalacOptions = commonScalacOptions
      def sources = Task.Sources(base / "01-core" / "src" / "main" / "scala")
      def moduleDeps = Seq(commons.jvm)
      def mvnDeps = domainMvnDeps
    }

    object js extends ScalaJSModule {
      def scalaVersion = scala3Version
      def scalaJSVersion = build.scalaJsVersion
      def scalacOptions = commonScalacOptions
      def sources = Task.Sources(base / "01-core" / "src" / "main" / "scala")
      def moduleDeps = Seq(commons.js)
      def mvnDeps = domainMvnDeps
    }
  }

  object `02-infra` extends ScalaModule {
    def scalaVersion = scala3Version
    def scalacOptions = commonScalacOptions
    def sources = Task.Sources(base / "02-infra" / "src" / "main" / "scala")
    def moduleDeps = Seq(`01-core`.jvm, domain.jvm)
    def mvnDeps = domainMvnDeps

    object test extends ScalaTests {
      def sources = Task.Sources(base / "02-infra" / "src" / "test" / "scala")
      def mvnDeps = Seq(
        mvn"dev.zio::zio-test::2.1.16",
        mvn"dev.zio::zio-test-sbt::2.1.16"
      )
      def testFramework = "zio.test.sbt.ZTestFramework"
    }
  }
}

// ---------------------------------------------------------------------------
// Customers — bounded context: who we sell to. Deliberately knows nothing
// about negotiated pricing; that is pricing's, resolved from a customer id.
// ---------------------------------------------------------------------------

object customers extends Module {
  private val base = rootDir / "modules" / "customers"

  object `01-core` extends ScalaModule {
    def scalaVersion = scala3Version
    def scalacOptions = commonScalacOptions
    def sources = Task.Sources(base / "01-core" / "src" / "main" / "scala")
    def moduleDeps = Seq(commons.jvm)
    def mvnDeps = domainMvnDeps
  }

  object `02-infra` extends ScalaModule {
    def scalaVersion = scala3Version
    def scalacOptions = commonScalacOptions
    def sources = Task.Sources(base / "02-infra" / "src" / "main" / "scala")
    def moduleDeps = Seq(`01-core`, domain.jvm)
    def mvnDeps = domainMvnDeps

    object test extends ScalaTests {
      def sources = Task.Sources(base / "02-infra" / "src" / "test" / "scala")
      def mvnDeps = Seq(
        mvn"dev.zio::zio-test::2.1.16",
        mvn"dev.zio::zio-test-sbt::2.1.16"
      )
      def testFramework = "zio.test.sbt.ZTestFramework"
    }
  }
}

// ---------------------------------------------------------------------------
// UI Framework — Laminar components, no domain dependency (Scala.js only)
// ---------------------------------------------------------------------------

object `ui-framework` extends ScalaJSModule {
  def scalaVersion = scala3Version
  def scalaJSVersion = build.scalaJsVersion
  def scalacOptions = commonScalacOptions
  def sources = Task.Sources(rootDir / "modules" / "ui-framework" / "src" / "main" / "scala")
  def resources = Task.Sources(rootDir / "modules" / "ui-framework" / "src" / "main" / "resources")
  def mvnDeps = Seq(
    mvn"com.raquo::laminar::${laminarVersion}"
  )
}

// ---------------------------------------------------------------------------
// UI Showcase — demo for UI Framework components (Scala.js only)
// ---------------------------------------------------------------------------

object `ui-showcase` extends ScalaJSModule {
  def scalaVersion = scala3Version
  def scalaJSVersion = build.scalaJsVersion
  def scalacOptions = commonScalacOptions
  def sources = Task.Sources(rootDir / "modules" / "ui-showcase" / "src" / "main" / "scala")
  def resources = Task.Sources(rootDir / "modules" / "ui-showcase" / "src" / "main" / "resources")
  def scalaJSUseMainModuleInitializer = true
  def moduleDeps = Seq(`ui-framework`)
  def mvnDeps = Seq(
    mvn"com.raquo::laminar::${laminarVersion}"
  )
}

// ---------------------------------------------------------------------------
// UI Product Builder — the shared product configurator (form, pricing, basket,
// e-mail order). Consumed by both the full SPA (`ui`) and the standalone
// embeddable calculator (`ui-calculator`).
// ---------------------------------------------------------------------------

object `ui-productbuilder` extends ScalaJSModule {
  def scalaVersion = scala3Version
  def scalaJSVersion = build.scalaJsVersion
  def scalacOptions = commonScalacOptions
  def sources = Task.Sources(rootDir / "modules" / "ui-productbuilder" / "src" / "main" / "scala")
  def resources = Task.Sources(rootDir / "modules" / "ui-productbuilder" / "src" / "main" / "resources")
  def moduleDeps = Seq(commons.js, domain.js, `ui-framework`)
  def mvnDeps = Seq(
    mvn"com.raquo::laminar::${laminarVersion}"
  )
}

// ---------------------------------------------------------------------------
// UI Calculator — standalone embeddable price calculator (Scala.js library:
// no main initializer, exports a global `MPCalculator` object)
// ---------------------------------------------------------------------------

object `ui-calculator` extends ScalaJSModule {
  def scalaVersion = scala3Version
  def scalaJSVersion = build.scalaJsVersion
  def scalacOptions = commonScalacOptions
  def sources = Task.Sources(rootDir / "modules" / "ui-calculator" / "src" / "main" / "scala")
  def resources = Task.Sources(rootDir / "modules" / "ui-calculator" / "src" / "main" / "resources")
  def scalaJSUseMainModuleInitializer = false
  def moduleDeps = Seq(commons.js, domain.js, `ui-framework`, `ui-productbuilder`)
  def mvnDeps = Seq(
    mvn"com.raquo::laminar::${laminarVersion}"
  )
}

// ---------------------------------------------------------------------------
// UI — main Scala.js web application
// ---------------------------------------------------------------------------

object ui extends ScalaJSModule {
  def scalaVersion = scala3Version
  def scalaJSVersion = build.scalaJsVersion
  def scalacOptions = commonScalacOptions
  def sources = Task.Sources(rootDir / "modules" / "ui" / "src" / "main" / "scala")
  def resources = Task.Sources(rootDir / "modules" / "ui" / "src" / "main" / "resources")
  def scalaJSUseMainModuleInitializer = true
  def moduleDeps = Seq(commons.js, domain.js, `ui-framework`, `ui-productbuilder`)
  def mvnDeps = Seq(
    mvn"com.raquo::laminar::${laminarVersion}"
  )
}
